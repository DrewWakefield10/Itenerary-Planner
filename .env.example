# All variables are server-side. Never prefix secrets with NEXT_PUBLIC_.
# Optional compatible chat-completions endpoint. No credentials = honest demo mode.
AI_API_KEY=
AI_CHAT_URL=
AI_MODEL=
# AI personalizes titles/themes/notes; seed selection, schedule and money remain deterministic.
# Enable only after reviewing Open-Meteo terms for your use.
WEATHER_ENABLED=false
# Optional commercial Open-Meteo key; switches to the customer endpoint.
WEATHER_API_KEY=
# Google-only personal accounts (server-side; never NEXT_PUBLIC_).
# Canonical public origin, without a path. Local: http://127.0.0.1:5173
BETTER_AUTH_URL=
# At least 32 random characters. Keep stable or sessions/OAuth tokens become invalid.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register the exact callback: <BETTER_AUTH_URL>/api/auth/callback/google
# Vercel requires persistent remote SQLite; Google credentials alone are insufficient.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# See docs/accounts.md for Vercel/Google setup and npm run db:migrate.
# Optional local-only Discover snapshot maintenance; no API token is needed.
# WIKIMEDIA_USER_AGENT=LakbayDiscoveryBot/1.0 (https://your-contact-page.example)
# DISCOVER_MIN_BASELINE=700
# DISCOVER_MIN_GROWTH=200
# DISCOVER_MIN_PERCENT=20
# DISCOVER_FRESHNESS_HOURS=72
